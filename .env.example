# Copy to .env and fill in. NEVER commit .env.
# Every value below is a secret or an account-scoped endpoint.

# --- RPC ---
STARKNET_RPC_URL=
STARKNET_RPC_URL_SEPOLIA=

# --- Deployer (use a fresh hackathon-only wallet, never a personal main wallet) ---
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# --- Tally service (SERVER-SIDE ONLY — must never reach browser code) ---
# Must be parsed as a BigInt. A hex string silently derives the wrong channel
# keys and notes sent to this identity will never decrypt.
DAO_VIEWING_KEY=

# --- STRK20 SDK infrastructure ---
# Sepolia values are published in the STRK20 docs; the mainnet equivalents were
# still unpublished as of Aug 16, 2026. See docs/ARCHITECTURE.md.
INDEXER_URL=
PROVING_SERVICE_URL=
