# Aperture — configuration.
#
# Copy to .env and fill in the blanks. .env is gitignored and must stay that
# way; nothing in this file is a secret, and nothing secret belongs in it.
#
# This file is generated from services/tally/src/env-spec.ts by
# `node scripts/sync-env-example.ts`. A test fails the build if the two drift,
# because the previous version declared four variables no code read, omitted
# thirteen the tally worker requires, and told the operator — in the text of
# MissingConfigError — to copy a file that did not contain the names it was
# asking for.

# ── Network ─────────────────────────────────────────────────────────────
# Required, and deliberately has no default. It used to default to mainnet,
# which contradicted services/tally/README.md and meant a mistyped value
# pointed real transactions at the live pool.
APERTURE_NETWORK=sepolia

# ── RPC ─────────────────────────────────────────────────────────────────
# sncast rejects anything below RPC spec 0.10 and Alchemy's bare host serves
# 0.8.1, failing with a misleading "Invalid block id". Use the explicitly
# versioned path for the _SNCAST variables. starknet.js is happy with either.
STARKNET_RPC_URL=
STARKNET_RPC_URL_SNCAST=
STARKNET_RPC_URL_SEPOLIA=
STARKNET_RPC_URL_SEPOLIA_SNCAST=

# ── STRK20 infrastructure ───────────────────────────────────────────────
# Public alpha endpoints, verified answering on 2026-08-23. Not secrets — see
# docs/evidence/2026-08-23-indexer-probe.md for the transcript, including the
# mainnet discovery service returning a well-formed response.
INDEXER_URL=https://discovery-service.alpha-sepolia.sw-dev.io
PROVING_SERVICE_URL=https://transaction-prover.alpha-sepolia.sw-dev.io
# Mainnet equivalents:
#   INDEXER_URL=https://discovery-service.alpha-mainnet.sw-dev.io
#   PROVING_SERVICE_URL=https://transaction-prover.alpha-mainnet.sw-dev.io

# ── Pool and token ──────────────────────────────────────────────────────
STRK20_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
STRK20_POOL_ADDRESS_SEPOLIA=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
STRK_TOKEN_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d

# ── Aperture contracts ──────────────────────────────────────────────────
# Addresses for the network selected above. See docs/DEPLOYMENTS.md.
APERTURE_REGISTRY_ADDRESS=
APERTURE_ANONYMIZER_ADDRESS=

# ── Ballot identity derivation ──────────────────────────────────────────
# Both are public. The class hash is the OpenZeppelin account class the ballot
# identities are deployed from; the public key is the public half of the DAO
# master key. Getting the class wrong yields addresses no account can be
# deployed at — that mistake superseded an entire Sepolia registry.
BALLOT_ACCOUNT_CLASS_HASH=0x5b4b537eaa2399e3aa99c4e2e0208ebd6c71bc1467938cd52c798c601e43564
DAO_MASTER_PUBLIC_KEY=0x660a41ee3edd08bd84276775ea1bed419f38ed8fe7bf4c07b522c3513a73e42

# ── Secrets ─────────────────────────────────────────────────────────────
# Use a fresh, hackathon-only wallet. Never a personal main wallet.
#
# These are four DIFFERENT keys with four different jobs. They used to be one
# scalar wearing four hats, and two of those hats send it to a third-party
# indexer in cleartext. Do not paste the same value into more than one; the
# loader rejects it if you do.

# Seeds every per-ballot viewing key. Never leaves this process — only its
# derived children are sent anywhere. Changing it rotates every ballot viewing
# key, which makes already-registered ballots unreadable.
DAO_BALLOT_VIEWING_SEED=

# Signs for every ballot identity account. Must be the private half of
# DAO_MASTER_PUBLIC_KEY above, or the accounts cannot sign.
DAO_BALLOT_ACCOUNT_PRIVATE_KEY=

# The voter's own pool viewing key. SENT TO THE INDEXER IN CLEARTEXT.
VOTER_VIEWING_KEY=

# The operator's pool viewing key, for the payout path. SENT TO THE INDEXER IN
# CLEARTEXT.
TALLY_OPERATOR_VIEWING_KEY=

# The account that publishes tallies on-chain.
TALLY_OPERATOR_ADDRESS=
TALLY_OPERATOR_PRIVATE_KEY=
