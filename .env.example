# Aperture — configuration.
#
# Copy to .env and fill in the blanks. .env is gitignored and must stay that
# way. Nothing in this file is a secret, and nothing secret belongs in it.
#
# GENERATED from services/tally/src/env-spec.ts by
# `node scripts/sync-env-example.ts`. Do not hand-edit: a test fails the build
# if this file and the spec disagree.

# ── Network ─────────────────────────────────────────────────────────────

# Required. mainnet or sepolia. Deliberately has no default: it used to
# fall back to mainnet, which contradicted the service's own README and
# meant a missing value pointed real transactions at the live pool.
APERTURE_NETWORK=sepolia

# ── RPC ─────────────────────────────────────────────────────────────────

# Required when APERTURE_NETWORK=mainnet. Mainnet RPC. Used when the
# _SNCAST variant is unset.
STARKNET_RPC_URL=

# Optional. Mainnet RPC on an explicitly versioned path. sncast rejects
# anything below RPC spec 0.10 and several providers still serve 0.8.1 on
# their bare host, failing with a misleading "Invalid block id". Preferred
# when present.
STARKNET_RPC_URL_SNCAST=

# Required when APERTURE_NETWORK=sepolia. Sepolia RPC. Used when the
# _SNCAST variant is unset.
STARKNET_RPC_URL_SEPOLIA=https://starknet-sepolia-rpc.publicnode.com

# Optional. Sepolia RPC on an explicitly versioned path. Required by
# scripts/deploy-sepolia.sh, which aborts without it.
STARKNET_RPC_URL_SEPOLIA_SNCAST=

# Optional. Overrides the endpoint scripts/verify-tx.ts and record-tx.ts
# read receipts from. Defaults to the one the organisers' checker uses.
STRK20_VERIFY_RPC=

# ── STRK20 infrastructure ───────────────────────────────────────────────

# Required. Discovery service. Public alpha infrastructure, not a secret.
# Verified answering a real sync request on 2026-08-23 — see
# docs/evidence/2026-08-23-indexer-probe.md. Must be https on mainnet: it
# receives a viewing key in cleartext.
INDEXER_URL=https://discovery-service.alpha-sepolia.sw-dev.io

# Required. Proving service. Answers /health on both networks; that is not
# the same as having produced a proof.
PROVING_SERVICE_URL=https://transaction-prover.alpha-sepolia.sw-dev.io

# ── Pool and token ──────────────────────────────────────────────────────

# Required when APERTURE_NETWORK=mainnet. STRK20 shielded pool on mainnet.
STRK20_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# Required when APERTURE_NETWORK=sepolia. STRK20 shielded pool on Sepolia.
STRK20_POOL_ADDRESS_SEPOLIA=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91

# Required. STRK. The same address on both networks.
STRK_TOKEN_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d

# ── Aperture contracts ──────────────────────────────────────────────────

# Required. ProposalRegistry on the selected network. See
# docs/DEPLOYMENTS.md.
APERTURE_REGISTRY_ADDRESS=

# Optional. Where payout preimages are written before a register
# transaction is submitted. Defaults to .payouts/, which is gitignored. A
# preimage is the only thing that can ever open an escrowed payout, and
# the anonymizer has no sweep, so losing one strands the value
# permanently.
APERTURE_PAYOUT_DIR=

# Optional. GovernanceAnonymizer. Required only by the payout lifecycle.
APERTURE_ANONYMIZER_ADDRESS=

# ── Ballot identity derivation ──────────────────────────────────────────

# Required. Account class the ballot identities are deployed from. Public.
# Getting it wrong yields addresses no account can be deployed at, which
# is what superseded an entire Sepolia registry.
BALLOT_ACCOUNT_CLASS_HASH=0x5b4b537eaa2399e3aa99c4e2e0208ebd6c71bc1467938cd52c798c601e43564

# Required. Public half of the DAO master key. Ballot addresses derive
# from it.
DAO_MASTER_PUBLIC_KEY=0x660a41ee3edd08bd84276775ea1bed419f38ed8fe7bf4c07b522c3513a73e42

# ── Secrets ─────────────────────────────────────────────────────────────

# Required. Seeds every per-ballot viewing key. Never leaves this process
# — only its derived children are sent anywhere. Changing it rotates every
# ballot viewing key, making already-registered ballots unreadable.
# SECRET — never commit a value for this.
DAO_BALLOT_VIEWING_SEED=

# Required. Signs for every ballot identity account. Must be the private
# half of DAO_MASTER_PUBLIC_KEY, and the loader checks that it is.
# SECRET — never commit a value for this.
DAO_BALLOT_ACCOUNT_PRIVATE_KEY=

# Optional. The voter's own pool viewing key, used by cast-vote. SENT TO
# THE INDEXER IN CLEARTEXT.
# SECRET — never commit a value for this.
VOTER_VIEWING_KEY=

# Optional. The operator's pool viewing key, used by the payout lifecycle.
# SENT TO THE INDEXER IN CLEARTEXT.
# SECRET — never commit a value for this.
TALLY_OPERATOR_VIEWING_KEY=

# Required. Account that publishes tallies on-chain.
TALLY_OPERATOR_ADDRESS=

# Required. Signs the finalize transaction.
# SECRET — never commit a value for this.
TALLY_OPERATOR_PRIVATE_KEY=
