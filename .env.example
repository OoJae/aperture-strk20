# Copy to .env and fill in. NEVER commit .env.
# Every value below is a secret or an account-scoped endpoint.

# --- RPC ---
# These public endpoints need no API key and were verified working on
# 2026-08-16 (mainnet returns SN_MAIN, Sepolia returns SN_SEPOLIA). Paste them
# as-is to get started; swap in a keyed provider before demo day, when a public
# endpoint's unpublished rate limit becomes a risk you cannot debug live.
#   Mainnet: https://starknet-rpc.publicnode.com
#   Sepolia: https://starknet-sepolia-rpc.publicnode.com
# The sprint organizers' own Day-0 doc uses https://rpc.starknet.lava.build for
# mainnet, which also works. Lava has no working Sepolia twin — don't guess one.
STARKNET_RPC_URL=
STARKNET_RPC_URL_SEPOLIA=

# Optional keyed fallback for demo day (Alchemy app key, one key for both):
#   https://starknet-mainnet.g.alchemy.com/v2/<KEY>
#   https://starknet-sepolia.g.alchemy.com/v2/<KEY>
STARKNET_RPC_URL_FALLBACK=

# --- Deployer (use a fresh hackathon-only wallet, never a personal main wallet) ---
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# --- Tally service (SERVER-SIDE ONLY — must never reach browser code) ---
# Must be parsed as a BigInt. A hex string silently derives the wrong channel
# keys and notes sent to this identity will never decrypt.
DAO_VIEWING_KEY=

# --- STRK20 SDK infrastructure ---
# Sepolia values are published in the STRK20 docs; the mainnet equivalents were
# still unpublished as of Aug 16, 2026. See docs/ARCHITECTURE.md.
INDEXER_URL=
PROVING_SERVICE_URL=
