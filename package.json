{
  "name": "aperture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sealed-ballot governance and a shielded treasury for DAOs, native to STRK20.",
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "starknet": "^10.4.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "ballot-vectors": "node scripts/ballot-vectors.ts",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "contracts:build": "cd contracts && scarb build",
    "contracts:test": "cd contracts && snforge test",
    "record-tx": "node scripts/record-tx.ts"
  }
}
