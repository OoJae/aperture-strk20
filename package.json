{
  "name": "aperture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sealed-ballot governance and a shielded treasury for DAOs, native to STRK20.",
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "starknet": "^10.4.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "ballot-vectors": "node scripts/ballot-vectors.ts",
    "build": "pnpm -r --if-present build",
    "test": "node --test scripts/tests/*.test.ts && pnpm -r --if-present test",
    "sync": "node scripts/sync-manifest.ts",
    "verify": "node scripts/verify-tx.ts --all",
    "contracts:build": "cd contracts && scarb build",
    "contracts:test": "cd contracts && snforge test",
    "record-tx": "node scripts/record-tx.ts",
    "deploy:site": "scripts/deploy-site.sh"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  }
}
