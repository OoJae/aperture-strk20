{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // The source imports carry explicit .ts extensions so Node can run it
    // without a build. On emit those must become .js or the published package
    // asks for files that are not there.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"],
  "exclude": ["tests"]
}
